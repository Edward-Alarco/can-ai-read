---
import '../styles/global.css';
import { translator, type Locale } from '../lib/i18n';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = translator(locale);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>{t("Can AI Read — Haz tu web más accesible para la IA")}</title>
    <meta name="description" content={t("Comprueba si la IA puede leer tu web pública: acceso, reglas de rastreo y texto extraíble del HTML. Evidencias claras y el siguiente paso, sin registro.")} />
    <meta name="keywords" content={t("inteligencia artificial, rastreo web, robots.txt, contenido extraíble, SEO técnico, accesibilidad para IA")} />
    <meta name="author" content="Edward Alarco" />
    <meta name="publisher" content="Edward Alarco" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..700&family=Space+Grotesk:wght@400..700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Open Graph se incorporará cuando estén definidos el dominio y la imagen. -->
  </head>
  <body><a class="skip" href="#main">{t("Saltar al contenido")}</a><slot /></body>
</html>

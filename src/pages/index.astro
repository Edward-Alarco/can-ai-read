---
import Layout from '../layouts/Layout.astro';
import { copy } from '../lib/diagnostics';
import { resolveLocale, translator } from '../lib/i18n';
const locale = resolveLocale(Astro.request.headers.get('accept-language'), Astro.cookies.get('language')?.value);
const t = translator(locale);
const s = (en: string, es: string) => copy(locale, en, es);
Astro.response.headers.set('Content-Language', locale);
Astro.response.headers.set('Vary', 'Accept-Language, Cookie');
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<Layout locale={locale}>
  <header class="site-header wrap flex items-center justify-between">
    <a href="/" class="brand" aria-label={t("Can AI Read, inicio")}><span class="brand-mark">&lt;/&gt;</span> can ai read<span class="brand-dot">.</span></a>
    <nav class="flex items-center gap-7" aria-label={t("Principal")}><div class="language-switch" role="group" aria-label={locale === 'es' ? 'Idioma' : 'Language'}><button type="button" data-language="en" aria-pressed={locale === 'en'} lang="en">EN</button><button type="button" data-language="es" aria-pressed={locale === 'es'} lang="es">ES</button></div><span class="version">BETA 0.1</span></nav>
  </header>
  <main id="main">
    <section class="hero wrap">
      <div class="w-full">
        <div class="eyebrow"><span class="live-dot"></span> {t("MENOS SUPOSICIONES. MÁS EVIDENCIAS.")}</div>
        <h1>{t("Tu web habla.")}<br />{t("¿La IA puede")} <span class="accent">{t("leerla?")}</span></h1>
        <p class="hero-description">{t("Descubre qué permite tu web, qué contenido podemos extraer")}<br class="desktop-break" /> {t("y qué está dificultando el acceso. Solo necesitas una URL.")}</p>
        <form id="audit-form" class="audit-form" novalidate>
          <label for="site-url" class="sr-only">{t("Dirección pública de tu página web")}</label>
          <div class="input-row"><span class="input-icon" aria-hidden="true">↗</span><input id="site-url" name="url" type="text" inputmode="url" autocomplete="url" spellcheck="false" placeholder={t("tuweb.com")} required maxlength="2048" aria-describedby="form-error" /><button id="analyze-button" type="submit">{t("Analizar mi web")} <img src="/magnifyingglass.svg" alt={t("Lupa")} width="32" height="32" /></button></div>
          <div id="form-error" role="alert" hidden></div>
        </form>
        <div class="form-details"><span><img src="/check.svg" alt={t("Marca de verificación")} width="32" height="32" />{t("Sin registro")}</span><span><img src="/check.svg" alt={t("Marca de verificación")} width="32" height="32" />{t("Sin claves de API")}</span><span><img src="/check.svg" alt={t("Marca de verificación")} width="32" height="32" />{t("Una URL por análisis")}</span></div>
        <div class="compatibility"><span>{t("REGLAS DE RASTREO PARA")}</span><div><img class="logo-openai" src="/openai.png" alt="OpenAI" width="666" height="181" /><img class="logo-anthropic" src="/anthropic.png" alt="Anthropic" width="666" height="128" /><img class="logo-google" src="/google.png" alt="Google" width="492" height="180" /></div></div>
      </div>
    </section>

    <section id="loading" class="wrap loading-panel" hidden aria-live="polite" aria-atomic="true"><div class="scan-line"></div><span class="eyebrow">{t("ANÁLISIS EN CURSO")}</span><p class="loading-title">{t("Siguiendo las señales de tu web")}<span class="accent">…</span></p><p id="loading-message">{t("Solicitando el HTML y comprobando las reglas de acceso.")}</p><div class="loader-track"><div></div></div></section>

    <section id="empty-result" class="wrap loading-panel" hidden><span class="eyebrow">{t("SIN RESULTADOS")}</span><p class="loading-title">{t("No se han encontrado resultados")}<span class="accent">.</span></p><p id="empty-message"></p><img class="empty-icon" src="/detective.svg" alt={t("Detective")} width="32" height="32"></section>

    <section id="report" class="wrap report-section" hidden tabindex="-1" aria-labelledby="report-heading">
      <div class="report-top"><div><span id="report-mode" class="eyebrow">{t("DIAGNÓSTICO DE PÁGINA")}</span><p class="loading-title" id="report-heading">{t("Tu informe, sin cajas negras.")}</p></div><button id="download-button" type="button" class="secondary-button">{t("Descargar JSON ↓")}</button></div>
      <div class="report-summary"><div><span class="status-row"><img class="status-icon" src="/crosshair.svg" alt={t("Estado del análisis")} width="32" height="32" /><span id="report-status" class="status-label"></span></span><p class="report-title" id="report-title"></p><a id="report-url" target="_blank" rel="noopener noreferrer"></a><p id="report-scope"></p></div><div class="metrics"><img id="desktop-screenshot" class="desktop-screenshot" alt={s('Desktop screenshot of the analyzed website','Captura de escritorio de la web analizada')} hidden /><div><strong id="word-count">0</strong><span>{t("palabras extraídas")}</span></div><div><strong id="link-count">0</strong><span>{t("enlaces internos")}</span></div></div></div>
      <section id="diagnostic-overview" class="diagnostic-overview" aria-label={s('Diagnostic overview','Resumen del diagnóstico')}></section>
      <div class="report-tabs" role="tablist" aria-label={t("Secciones del informe")}><button type="button" role="tab" id="tab-findings" aria-selected="true" aria-controls="panel-findings" data-tab="findings">01 <span>{t("Diagnóstico")}</span></button><button type="button" role="tab" id="tab-agents" aria-selected="false" aria-controls="panel-agents" tabindex="-1" data-tab="agents">02 <span>{t("Rastreadores")}</span></button><button type="button" role="tab" id="tab-text" aria-selected="false" aria-controls="panel-text" tabindex="-1" data-tab="text">03 <span>{t("Vista de lectura")}</span></button></div>
      <div id="panel-findings" role="tabpanel" aria-labelledby="tab-findings">
        <div id="diagnostic-filters" class="diagnostic-filters"></div>
        <p id="diagnostic-result-count" class="audit-small" role="status" aria-live="polite"></p>
        <div id="findings-list"></div><div id="diagnostic-resources"></div>
      </div>
      <div id="panel-agents" role="tabpanel" aria-labelledby="tab-agents" hidden><div class="panel-intro"><p class="panel-title">{t("Distintos agentes. Distintos permisos.")}</p><p>{t("Estas son las reglas declaradas para la ruta analizada. No prueban que el proveedor haya visitado tu web ni que su infraestructura pueda acceder.")}</p></div><div id="agents-list"></div><p class="report-note">{t("Restringir entrenamiento puede ser tu elección. No lo tratamos como un error.")}</p></div>
      <div id="panel-text" role="tabpanel" aria-labelledby="tab-text" hidden><div class="panel-intro"><p class="panel-title">{t("El contenido que pudimos extraer.")}</p><p>{t("Extracción de nuestro analizador, hasta 16 000 caracteres. No reproduce exactamente lo que ve cada proveedor ni ejecuta JavaScript.")}</p></div><div id="extracted-text" class="extracted-text"></div></div>
      <p class="report-note">{t("Una comprobación técnica no garantiza indexación, posiciones ni menciones en respuestas de IA.")}</p>
    </section>

    <section id="como-funciona" class="wrap how-section">
      <div class="section-heading"><div><span class="eyebrow">{t("DEL ENLACE A LA EVIDENCIA")}</span><h2>{t("Claridad en tres pasos")}<span class="accent">.</span></h2></div><p>{t("Sin una puntuación misteriosa.")}<br />{t("Comprueba, entiende y mejora.")}</p></div>
      <div class="steps-grid grid md:grid-cols-3">
        <article><div class="step-top"><img class="step-symbol" src="/share.svg" alt={t("Compartir")} width="32" height="32" /></div><h3>{t("Comparte una URL")}</h3><p>{t("Una página pública de tu negocio, tu proyecto o el sitio de un cliente.")}</p><span class="step-tag">{t("EL PUNTO DE PARTIDA")}</span></article>
        <article><div class="step-top"><img class="step-symbol" src="/rss.svg" alt={t("Señales")} width="32" height="32" /></div><h3>{t("Revisamos las señales")}</h3><p>{t("Acceso HTTP, reglas de rastreo y contenido disponible en el HTML inicial.")}</p><span class="step-tag">{t("COMPROBACIONES REPRODUCIBLES")}</span></article>
        <article><div class="step-top"><img class="step-symbol" src="/receipt.svg" alt={t("Recibo")} width="32" height="32" /></div><h3>{t("Actúa con contexto")}</h3><p>{t("Cada hallazgo incluye una evidencia y un siguiente paso que puedes revisar.")}</p><span class="step-tag">{t("ACCIONES, NO ADIVINANZAS")}</span></article>
      </div>
    </section>

    <section id="criterios" class="wrap criteria-section grid md:grid-cols-2">
      <div><span class="eyebrow">{t("SABER QUÉ ESTÁS MIDIENDO")}</span><h2>{t("Accesible no significa")}<br /><span class="muted">{t("automáticamente citado.")}</span></h2><p>{t("Analizamos lo que podemos observar y señalamos lo que no podemos verificar. Así sabes exactamente qué hacer con el resultado.")}</p><a class="text-link" href="#site-url">{t("Comprueba tu primera página ↗")}</a></div>
      <div class="criteria-list"><div><span class="criterion-icon"><img src="/check.svg" alt={t("Marca de verificación")} width="32" height="32" /></span><p><strong>{t("Acceso y permisos")}</strong><span>{t("Respuesta del servidor y reglas por rastreador.")}</span></p><span class="small-tag">{t("INCLUIDO")}</span></div><div><span class="criterion-icon"><img src="/check.svg" alt={t("Marca de verificación")} width="32" height="32" /></span><p><strong>{t("Contenido extraíble")}</strong><span>{t("Texto, encabezados y enlaces en el HTML.")}</span></p><span class="small-tag">{t("INCLUIDO")}</span></div><div><span class="criterion-icon neutral"><img src="/minus.svg" alt={t("Fuera de alcance")} width="32" height="32" /></span><p><strong>{t("Indexación y citas reales")}</strong><span>{t("Requieren datos y mediciones adicionales.")}</span></p><span class="small-tag neutral">{t("FUERA DE ALCANCE")}</span></div></div>
    </section>

    <section class="wrap faq-section"><span class="eyebrow">{t("LAS PREGUNTAS CORRECTAS")}</span><h2>{t("Antes de analizar")}<span class="accent">.</span></h2><div class="faq-list">
      <details name="faq" open><summary>{t("¿Esto me dice si apareceré en ChatGPT?")}<span><img class="faq-plus" src="/plus.svg" alt={t("Expandir")} width="32" height="32" /><img class="faq-x" src="/x.svg" alt={t("Cerrar")} width="32" height="32" /></span></summary><p>{t("No. Detecta barreras técnicas observables. Que una página sea accesible no garantiza que un proveedor la descubra, la indexe o la cite.")}</p></details>
      <details name="faq"><summary>{t("¿Necesito permitir el entrenamiento de modelos?")}<span><img class="faq-plus" src="/plus.svg" alt={t("Expandir")} width="32" height="32" /><img class="faq-x" src="/x.svg" alt={t("Cerrar")} width="32" height="32" /></span></summary><p>{t("Es una decisión independiente de permitir ciertos rastreadores de búsqueda. Mostramos los agentes de búsqueda y entrenamiento por separado, sin penalizar tus preferencias.")}</p></details>
      <details name="faq"><summary>{t("¿Es obligatorio tener un archivo llms.txt?")}<span><img class="faq-plus" src="/plus.svg" alt={t("Expandir")} width="32" height="32" /><img class="faq-x" src="/x.svg" alt={t("Cerrar")} width="32" height="32" /></span></summary><p>{t("No lo consideramos un requisito. Google documenta que no lo utiliza para mejorar la visibilidad de una página en Search. Consulta siempre la documentación de cada proveedor.")}</p></details>
      <details name="faq"><summary>{t("¿Qué pasa si mi web utiliza JavaScript?")}<span><img class="faq-plus" src="/plus.svg" alt={t("Expandir")} width="32" height="32" /><img class="faq-x" src="/x.svg" alt={t("Cerrar")} width="32" height="32" /></span></summary><p>{t("Esta versión inspecciona el HTML que envía el servidor, sin ejecutar JavaScript. Una extracción escasa señala algo que revisar; no prueba que todos los asistentes sean incapaces de leer tu sitio.")}</p></details>
      <details name="faq"><summary>{t("¿Se guardan mis análisis?")}<span><img class="faq-plus" src="/plus.svg" alt={t("Expandir")} width="32" height="32" /><img class="faq-x" src="/x.svg" alt={t("Cerrar")} width="32" height="32" /></span></summary><p>{t("No guardamos informes en una base de datos. El resultado se mantiene en esta pestaña y puedes descargarlo. El proveedor de alojamiento puede conservar registros técnicos. Analiza únicamente URLs públicas sin información sensible.")}</p></details>
    </div></section>
    <section class="wrap sources"><span>{t("CRITERIOS BASADOS EN DOCUMENTACIÓN PÚBLICA")}</span><div><a href="https://developers.openai.com/api/docs/bots" target="_blank" rel="noopener noreferrer">OpenAI <img src="/arrowupright.svg" alt={t("Enlace externo")} width="32" height="32" /></a><a href="https://support.claude.com/en/articles/8896518-does-anthropic-crawl-data-from-the-web-and-how-can-site-owners-block-the-crawler" target="_blank" rel="noopener noreferrer">Anthropic <img src="/arrowupright.svg" alt={t("Enlace externo")} width="32" height="32" /></a><a href="https://developers.google.com/search/docs/appearance/ai-features" target="_blank" rel="noopener noreferrer">Google Search <img src="/arrowupright.svg" alt={t("Enlace externo")} width="32" height="32" /></a></div></section>
  </main>
  <footer class="wrap site-footer"><a href="/" class="brand"><span class="brand-mark">&lt;/&gt;</span> can ai read<span class="brand-dot">.</span></a><span>{t("Construido para entender la web.")}</span><a href="#main">{t("Volver arriba")} <img src="/arrowup.svg" alt={t("Flecha hacia arriba")} width="32" height="32" /></a></footer>
</Layout>
<script>
  import '../lib/client';
</script>
